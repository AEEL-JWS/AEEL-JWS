---
import { assetUrl } from '../lib/links';
interface Props { person: {name:string;role:string;degree?:string;program?:string;researchArea?:string;interests?:string;introduction?:string;keywords?:string;email?:string;image?:string;link?:string}; }
const {person}=Astro.props;
---
<article class="person-card surface-card"><div class="person-photo">{person.image?<img src={assetUrl(person.image)} alt={person.name} loading="lazy" />:<span aria-hidden="true">{person.name.split(' ').map(w=>w[0]).join('').slice(0,2)}</span>}</div><span class="card-kicker">{person.role}</span><h3>{person.name}</h3>{(person.degree||person.program)&&<p class="person-program">{[person.degree,person.program].filter(Boolean).join(' · ')}</p>}{(person.researchArea||person.interests)&&<p>{person.researchArea||person.interests}</p>}{person.introduction&&<p>{person.introduction}</p>}{person.keywords&&<p class="person-keywords">{person.keywords}</p>}<div class="person-links">{person.email&&<a href={`mailto:${person.email}`}>{person.email} ↗</a>}{person.link&&<a href={person.link} target="_blank" rel="noopener noreferrer">Profile ↗</a>}</div></article>
