---
interface Props {item:{title:string;year:number;authors?:string;journal:string;volume?:string;issue?:string;pages?:string;doi?:string;link?:string;area?:string;publicationType?:string;image?:string};}
const {item}=Astro.props;
const url=item.doi||item.link;
---
<article class="publication-row" data-publication data-search={`${item.title} ${item.authors||''} ${item.journal} ${item.year} ${item.area||''}`.toLowerCase()} data-journal={item.journal}><span class="publication-year">{item.year}</span><div><h3>{item.title}</h3>{item.authors&&<p class="publication-authors">{item.authors}</p>}<p class="publication-meta">{[item.journal,item.volume&&`Vol. ${item.volume}`,item.issue&&`No. ${item.issue}`,item.pages,item.publicationType].filter(Boolean).join(' · ')}</p>{item.area&&<span class="pill">{item.area}</span>}</div>{url&&<a class="publication-arrow" href={url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${item.title}`}>↗</a>}</article>
