---
interface Props {item:{title:string;year:number;authors?:string;journal:string;volume?:string;issue?:string;pages?:string;bibliography?:string;status?:string;doi?:string;link?:string;area?:string;publicationType?:string;coverType?:string;image?:string};}
const {item}=Astro.props;
const articleUrl=item.link && item.link!==item.doi ? item.link : undefined;
const citationDetails=[item.volume,item.issue,item.pages].filter(Boolean).join(', ') || item.bibliography;
const citation=item.status==='Accepted'
  ? `${item.journal} (${item.year}) (Accepted)`
  : `${item.journal}${citationDetails ? ` ${citationDetails}` : ''} (${item.year})${item.status ? ` (${item.status})` : ''}`;
---
<article class="publication-row" data-publication data-search={`${item.title} ${item.authors||''} ${item.journal} ${item.year} ${item.area||''}`.toLowerCase()} data-journal={item.journal}><span class="publication-year">{item.year}</span><div><h3>{item.title}</h3>{item.authors&&<p class="publication-authors">{item.authors}</p>}<p class="publication-meta">{citation}{item.publicationType&&` · ${item.publicationType}`}</p>{item.coverType&&<span class="pill">{item.coverType}</span>}{item.area&&<span class="pill">{item.area}</span>}</div><div class="publication-links">{item.doi&&<a href={item.doi} target="_blank" rel="noopener noreferrer" aria-label={`Open DOI for ${item.title}`}>DOI ↗</a>}{articleUrl&&<a href={articleUrl} target="_blank" rel="noopener noreferrer" aria-label={`Open article for ${item.title}`}>Article ↗</a>}</div></article>
