---
import { pageUrl, assetUrl } from '../lib/links';
import { heroImages } from '../data/heroImages';
interface Props { section: string; title: string; intro: string; tabs?: [string,string][]; image?: string; imagePosition?: string; mobileImagePosition?: string; }
const {section,title,intro,tabs=[],image,imagePosition,mobileImagePosition}=Astro.props;
const family=section.split('/')[0].trim().toLowerCase();
const configuredHero=heroImages[section] || heroImages[section.split('/')[0].trim()];
const heroImage=image || configuredHero?.image;
const heroPosition=imagePosition || configuredHero?.position || 'center 56%';
const heroPositionMobile=mobileImagePosition || configuredHero?.mobilePosition || '65% center';
---
<section class:list={['page-hero','content-hero',`content-hero--${family}`,{'content-hero--inner':section.includes('/')}]}>
  {heroImage && <img class="content-hero-image" src={assetUrl(heroImage)} alt="" aria-hidden="true" style={`--hero-position:${heroPosition};--hero-position-mobile:${heroPositionMobile}`} />}
  <div class="shell page-heading"><span class="eyebrow">{section}</span><h1>{title}</h1><p>{intro}</p></div>
</section>
{tabs.length>0 && <nav class="section-tabs" aria-label={`${section} pages`}><div class="shell">{tabs.map(([label,path]) => <a href={pageUrl(path)} aria-current={Astro.url.pathname===pageUrl(path)?'page':undefined}>{label}</a>)}</div></nav>}
