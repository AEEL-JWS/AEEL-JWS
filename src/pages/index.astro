---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pageUrl, assetUrl } from '../lib/links';
import '../styles/home.css';

const research = await getCollection('research');
const areas = [
  {id:'advanced-photovoltaics', name:'Photovoltaics'},
  {id:'nir-photodiodes', name:'Photodetectors'},
  {id:'optoelectronic-memristors', name:'Neuromorphic Devices'},
  {id:'stretchable-devices', name:'Flexible Electronics'},
].map(area => ({...area, entry:research.find(item => item.id === area.id)})).filter(area => area.entry);
const papers = (await getCollection('publications')).sort((a,b) => b.data.year-a.data.year || a.data.order-b.data.order);
const selectedPapers = (papers.some(item => item.data.featured) ? papers.filter(item => item.data.featured) : papers).slice(0,5);
const news = (await getCollection('news')).sort((a,b) => b.data.date.getTime()-a.data.date.getTime());
const notices = (await getCollection('notices')).filter(item => item.data.active).sort((a,b) => b.data.date.getTime()-a.data.date.getTime()).slice(0,4);
const dateLabel = (date:Date) => date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
---
<BaseLayout title="Advanced Electronic Device & Energy Conversion System Lab" active="">
  <section class="editorial-hero">
    <div class="editorial-hero-image" aria-hidden="true"><img src={assetUrl('/images/editorial/wafer-probing.webp')} alt="" /></div>
    <div class="shell editorial-hero-inner"><div class="editorial-hero-copy">
      <div class="editorial-kicker">Korea University <span></span></div>
      <p class="editorial-lab-name">Advanced Electronic Device &amp;<br />Energy Conversion System Lab.</p>
      <h1>Materials for<br /><em>Intelligent Electronics.</em></h1>
      <p class="editorial-hero-description">We develop next-generation electronic and energy conversion devices through materials innovation, interface engineering, and system integration.</p>
      <div class="editorial-actions"><a class="button" href={pageUrl('research')}>Explore Research <span aria-hidden="true">→</span></a><a class="editorial-outline" href={pageUrl('publications/papers')}>Our Publications</a></div>
    </div></div><p class="editorial-hero-caption">Materials · Devices · Energy Conversion</p>
  </section>
  <section class="editorial-section editorial-research" id="research"><div class="shell">
    <div class="editorial-section-heading"><div><span class="editorial-overline">Research areas</span><h2>Four Research Areas<br />for a Brighter Future.</h2></div><a class="editorial-view-all" href={pageUrl('research')}>View all research <span aria-hidden="true">↗</span></a></div>
    <div class="editorial-research-grid">{areas.map((area,index) => <a class="editorial-research-card" href={pageUrl(`research/${area.entry!.id}`)}><div class="editorial-card-photo"><img src={assetUrl(area.entry!.data.image || '')} alt="" loading="lazy" /></div><div class="editorial-card-shade"></div><div class="editorial-card-copy"><span class="editorial-card-number">{String(index+1).padStart(2,'0')}</span><h3>{area.name}</h3><p>{area.entry!.data.summary}</p><span class="editorial-card-arrow" aria-hidden="true">↗</span></div></a>)}</div>
  </div></section>
  <section class="editorial-section editorial-publications"><div class="shell">
    <div class="editorial-section-heading"><div><span class="editorial-overline">Selected work</span><h2>Recent Publications.</h2></div><a class="editorial-view-all" href={pageUrl('publications/papers')}>All publications <span aria-hidden="true">↗</span></a></div>
    <div class="editorial-paper-grid">{selectedPapers.map(item => <article class="editorial-paper-card"><div class="editorial-paper-cover">{item.data.image ? <img src={assetUrl(item.data.image)} alt={`${item.data.journal} cover`} loading="lazy" /> : <span>{item.data.journal}</span>}</div><div class="editorial-paper-meta">{item.data.year} <span>·</span> {item.data.journal}</div><h3>{item.data.title}</h3>{(item.data.doi || item.data.link) && <a href={item.data.doi || item.data.link} target="_blank" rel="noopener noreferrer">Read paper <span aria-hidden="true">↗</span></a>}</article>)}</div>
  </div></section>
  <section class="editorial-section editorial-updates"><div class="shell"><div class="editorial-section-heading"><div><span class="editorial-overline">From AEEL</span><h2>News &amp; Notices.</h2></div></div><div class="editorial-updates-grid">
    <div class="editorial-news-lead"><div class="editorial-column-heading"><h3>News</h3><a href={pageUrl('board/news')}>View all <span aria-hidden="true">↗</span></a></div>{news[0] && <a class="editorial-lead-story" href={pageUrl(`board/news/${news[0].id}`)}><div class="editorial-story-image">{news[0].data.image ? <img src={assetUrl(news[0].data.image)} alt="" loading="lazy" /> : <span>AEEL <small>Research news</small></span>}</div><span class="editorial-story-date">{dateLabel(news[0].data.date)}</span><h4>{news[0].data.title}</h4><p>{news[0].data.summary}</p><span class="editorial-story-arrow" aria-hidden="true">↗</span></a>}</div>
    <div class="editorial-news-more"><div class="editorial-column-heading editorial-column-heading-spacer"><span>Latest stories</span></div>{news.slice(1,4).map(item => <a class="editorial-list-story" href={pageUrl(`board/news/${item.id}`)}><time>{dateLabel(item.data.date)}</time><h4>{item.data.title}</h4><span aria-hidden="true">↗</span></a>)}</div>
    <div class="editorial-notices"><div class="editorial-column-heading"><h3>Notices</h3><a href={pageUrl('board/notices')}>View all <span aria-hidden="true">↗</span></a></div>{notices.map(item => <a class="editorial-list-story" href={pageUrl(`board/notices/${item.id}`)}><time>{dateLabel(item.data.date)} <span class="editorial-category">{item.data.category || 'Notice'}</span></time><h4>{item.data.title}</h4><span aria-hidden="true">↗</span></a>)}</div>
  </div></div></section>
  <section class="editorial-bottom-banner"><img src={assetUrl('/images/editorial/materials-tomorrow.webp')} alt="Research materials and semiconductor wafers at a laboratory workbench" loading="lazy" /><div class="shell editorial-banner-content"><span class="editorial-overline">Korea University · AEEL</span><h2>From Materials<br />to a Smarter Tomorrow.</h2><p>Advanced Electronic Device &amp; Energy Conversion System Lab.</p><a href={pageUrl('contact')}>Connect with AEEL <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
