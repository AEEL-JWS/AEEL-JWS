---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pageUrl, assetUrl } from '../lib/links';

const research = (await getCollection('research')).sort((a,b) => a.data.order - b.data.order);
const featuredResearch = (research.filter(item => item.data.featured).length ? research.filter(item => item.data.featured) : research).slice(0, 3);
const publications = (await getCollection('publications')).sort((a,b) => b.data.year - a.data.year);
const featuredPublications = (publications.filter(item => item.data.featured).length ? publications.filter(item => item.data.featured) : publications).slice(0, 3);
const news = (await getCollection('news')).sort((a,b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
---

<BaseLayout title="Advanced Electronic Device & Energy Conversion System Lab" active="">
  <section class="hero">
    <div class="shell hero-inner">
      <div class="hero-copy">
        <div class="hero-kicker"><span></span>KOREA UNIVERSITY RESEARCH LABORATORY</div>
        <h1>Advancing<br /><em>electronics</em><br />for a changing world.</h1>
        <p>We explore emerging materials and device architectures for sensing, memory, and energy conversion.</p>
        <div class="hero-actions"><a class="button" href={pageUrl('research')}>Explore our research <span aria-hidden="true">↗</span></a><a class="hero-secondary" href={pageUrl('publications/papers')}>View publications <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-grid"></div><div class="hero-glow"></div><div class="hero-orbit orbit-a"></div><div class="hero-orbit orbit-b"></div><div class="hero-orbit orbit-c"></div>
        <div class="hero-device"><div class="device-layer layer-one"></div><div class="device-layer layer-two"></div><div class="device-layer layer-three"></div><div class="device-core"></div></div>
        <div class="art-label label-one">01 / MATERIALS</div><div class="art-label label-two">02 / DEVICES</div><div class="art-label label-three">03 / SYSTEMS</div>
      </div>
    </div>
    <div class="shell hero-foot"><span>ADVANCED ELECTRONIC DEVICE & ENERGY CONVERSION SYSTEM LAB</span><span>SEOUL · SOUTH KOREA</span></div>
  </section>

  <section class="mission-strip"><div class="shell mission-inner"><span class="eyebrow">Our mission</span><p>From fundamental material insights to functional devices, we connect scientific discovery with technologies that matter.</p><a class="text-link" href={pageUrl('members/researchers')}>Meet the team</a></div></section>

  <section class="section" id="research"><div class="shell"><div class="section-head"><div><span class="eyebrow">What we study</span><h2>Research directions</h2><p>Exploring the intersection of advanced materials, optoelectronics, and energy systems.</p></div><a class="text-link" href={pageUrl('research')}>All research</a></div><div class="card-grid">
    {featuredResearch.map((item, i) => <a class="research-card surface-card" href={pageUrl(`research/${item.id}`)}><div class={`research-visual default-${i+1}`}>{item.data.image && <img src={assetUrl(item.data.image)} alt="" loading="lazy" />}</div><div class="research-card-body"><span class="card-kicker">{item.data.eyebrow || `RESEARCH 0${i+1}`}</span><h3>{item.data.title}</h3><p>{item.data.summary}</p><span class="text-link">Explore area</span></div></a>)}
  </div></div></section>

  <section class="section home-publications"><div class="shell"><div class="section-head"><div><span class="eyebrow">Selected work</span><h2>Recent publications</h2><p>Research findings from across our device and energy programs.</p></div><a class="text-link" href={pageUrl('publications/papers')}>All publications</a></div><div class="publication-list">
    {featuredPublications.map(item => <article class="publication-row"><span class="publication-year">{item.data.year}</span><div><h3>{item.data.title}</h3><p class="publication-meta">{item.data.journal}{item.data.area ? ` · ${item.data.area}` : ''}</p></div>{(item.data.doi || item.data.link) && <a class="publication-arrow" href={item.data.doi || item.data.link} target="_blank" rel="noopener noreferrer" aria-label={`Read ${item.data.title}`}>↗</a>}</article>)}
  </div></div></section>

  <section class="feature-band"><div class="shell feature-band-inner"><div><span class="eyebrow">The next chapter</span><h2>Curiosity meets collaboration.</h2><p>We welcome motivated researchers interested in electronic devices, photonics, and sustainable energy technologies.</p></div><a class="button button-light" href={pageUrl('contact')}>Join our lab <span aria-hidden="true">↗</span></a></div></section>

  <section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">From the lab</span><h2>Latest news</h2></div><a class="text-link" href={pageUrl('board/news')}>All news</a></div><div class="news-list">
    {news.map(item => <a class="news-item" href={pageUrl(`board/news/${item.id}`)}><span class="news-date">{item.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span><div><span class="pill">{item.data.category}</span><h3>{item.data.title}</h3><p>{item.data.summary}</p></div><span class="news-arrow" aria-hidden="true">↗</span></a>)}
  </div></div></section>
</BaseLayout>
