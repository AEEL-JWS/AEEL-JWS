---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import {publicationTabs} from '../../lib/navigation';
import {getCollection} from 'astro:content';
import {newestFirst, patentEffectiveDate, patentSortKey} from '../../lib/publicationSort.mjs';

const patents = (await getCollection('patents'))
  .filter(item => item.data.active)
  .sort(newestFirst(patentSortKey));
const years = [...new Set(patents.map(item => patentEffectiveDate(item.data).getFullYear()))];
const date = (value?: Date) => value ? `${value.getFullYear()}.${String(value.getMonth()+1).padStart(2,'0')}.${String(value.getDate()).padStart(2,'0')}` : '';
---
<BaseLayout title="Patents" active="publications">
  <SectionHero section="Publications / Patents" title="Patents" intro="Patents and intellectual property developed through AEEL research." tabs={publicationTabs}/>
  <section class="section"><div class="shell">
    {patents.length ? <>
      <div class="patent-filters" role="group" aria-label="Filter patents by status">
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        <button type="button" data-filter="등록" aria-pressed="false">Registered</button>
        <button type="button" data-filter="출원" aria-pressed="false">Application</button>
      </div>
      {years.map(year => <section class="publication-year-group" data-year-group>
        <h2 class="year-heading">{year}</h2>
        <div class="record-list">
          {patents.filter(item => patentEffectiveDate(item.data).getFullYear() === year).map(item => <article class="record-row patent-record" data-patent data-status={item.data.status}>
            <div>
              <span class="record-badge">{item.data.status === '등록' ? 'Registered' : 'Application'}</span>
              <h3>{item.data.title}</h3>
              {item.data.inventors && <p class="record-authors">{item.data.inventors}</p>}
              <div class="patent-metadata">
                <p><strong>Application</strong><span>{item.data.applicationCountries} · {date(item.data.applicationDate)}</span></p>
                <p><strong>Application No.</strong><span>{item.data.applicationNumber}</span></p>
                {item.data.registrationDate && <p><strong>Registered</strong><span>{date(item.data.registrationDate)}</span></p>}
                {item.data.registrationNumber && <p><strong>Registration No.</strong><span>{item.data.registrationNumber}</span></p>}
              </div>
            </div>
          </article>)}
        </div>
      </section>)}
    </> : <p class="empty-state">Patent records will appear here as they are added.</p>}
  </div></section>
</BaseLayout>

<script>
  const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  filters.forEach(button => button.addEventListener('click', () => {
    const status=button.dataset.filter;
    filters.forEach(item => item.setAttribute('aria-pressed',String(item===button)));
    document.querySelectorAll<HTMLElement>('[data-patent]').forEach(item => item.hidden=status!=='all' && item.dataset.status!==status);
    document.querySelectorAll<HTMLElement>('[data-year-group]').forEach(group => group.hidden=!group.querySelector('[data-patent]:not([hidden])'));
  }));
</script>

<style>
  .patent-filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:33px}
  .patent-filters button{border:1px solid #d9e1e8;background:#fff;color:#526174;padding:9px 17px;font-size:12px;font-weight:800;border-radius:3px}
  .patent-filters button:hover,.patent-filters button[aria-pressed="true"]{background:#a62135;border-color:#a62135;color:#fff}
  .patent-filters button:focus-visible{outline:2px solid #a62135;outline-offset:2px}
  .patent-record[hidden],.publication-year-group[hidden]{display:none}
  .patent-record>div{min-width:0;width:100%}
  .patent-record h3{font-size:clamp(18px,2vw,22px);line-height:1.38;margin:11px 0 9px;overflow-wrap:anywhere}
  .patent-record .record-authors{font-size:14px;color:#4f5f70;line-height:1.6;margin:0 0 15px;overflow-wrap:anywhere}
  .record-badge{display:inline-block;background:#f4e9ec;color:#8f1d35;border:1px solid #ead5da;border-radius:2px;padding:5px 8px;font:800 10px/1.2 Manrope,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase}
  .patent-metadata{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px 25px;max-width:830px}
  .patent-metadata p{display:flex;gap:11px;margin:0;line-height:1.55;font-size:12px;overflow-wrap:anywhere}
  .patent-metadata strong{color:#687789;min-width:104px;font-weight:700}
  .patent-metadata span{color:#405166}
  @media(max-width:720px){.patent-metadata{grid-template-columns:1fr}}
</style>
