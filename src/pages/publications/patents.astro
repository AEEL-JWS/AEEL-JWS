---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import {publicationTabs} from '../../lib/navigation';
import {getCollection} from 'astro:content';
const patents=(await getCollection('patents')).sort((a,b)=>a.data.order-b.data.order);
const date=(d?:Date)=>d?d.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}):'';
---
<BaseLayout title="Patents" active="publications"><SectionHero section="Publications / Patents" title="Patents" intro="Patents and intellectual property developed through AEEL research." tabs={publicationTabs}/><section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">Intellectual property</span><h2>Patents</h2></div></div>{patents.length?<div class="record-list">{patents.map(item=><article class="record-row"><div><span class="card-kicker">{[item.data.country,item.data.status].filter(Boolean).join(' · ')}</span><h3>{item.data.title}</h3><p>{item.data.inventors}</p><p class="record-meta">{[item.data.number,item.data.applicationDate&&'Filed '+date(item.data.applicationDate),item.data.registrationDate&&'Registered '+date(item.data.registrationDate)].filter(Boolean).join(' · ')}</p></div>{item.data.link&&<a class="text-link" href={item.data.link} target="_blank" rel="noopener noreferrer">View patent</a>}</article>)}</div>:<p class="empty-state">Patent records will appear here as they are added.</p>}</div></section></BaseLayout>
