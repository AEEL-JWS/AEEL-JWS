---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import {publicationTabs} from '../../lib/navigation';
import {getCollection} from 'astro:content';
import {conferenceSortKey, conferenceYear, newestFirst} from '../../lib/publicationSort.mjs';

const talks = (await getCollection('conferences'))
  .filter(item => item.data.active)
  .sort(newestFirst(conferenceSortKey));
const years = [...new Set(talks.map(item => conferenceYear(item.data)))];
const eventMonth = (data: typeof talks[number]['data']) => data.month || (data.eventDate ? data.eventDate.toLocaleString('en-US', {month:'long', timeZone:'UTC'}) : '');
---
<BaseLayout title="Conferences" active="publications">
  <SectionHero section="Publications / Conferences" title="Conferences" intro="Conference presentations, invited talks, and posters." tabs={publicationTabs}/>
  <section class="section"><div class="shell">
    {talks.length ? years.map(year => <section class="publication-year-group">
      <h2 class="year-heading">{year}</h2>
      <div class="record-list">
        {talks.filter(item => conferenceYear(item.data) === year).map(item => <article class="record-row conference-record">
          <div>
            {item.data.title ? <p class="record-event">{item.data.event}</p> : <h3 class="record-event-primary">{item.data.event}</h3>}
            {item.data.title && <h3>{item.data.title}</h3>}
            {item.data.authors && <p class="record-authors">{item.data.authors}</p>}
            <div class="record-details">
              {item.data.type && item.data.type !== 'Not specified' && <span class="record-badge">{item.data.type}</span>}
              <span>{[eventMonth(item.data), String(conferenceYear(item.data))].filter(Boolean).join(' ')}</span>
              {(item.data.location || item.data.country) && <span>{item.data.location || item.data.country}</span>}
            </div>
          </div>
        </article>)}
      </div>
    </section>) : <p class="empty-state">Conference presentations will appear here as they are added.</p>}
  </div></section>
</BaseLayout>

<style>
  .conference-record>div{min-width:0;width:100%}
  .conference-record .record-event{font:800 12px/1.5 Manrope,Arial,sans-serif;color:#a62135;letter-spacing:.02em;margin:0 0 8px;overflow-wrap:anywhere}
  .conference-record .record-event-primary{margin-bottom:12px}
  .conference-record h3{font-size:clamp(18px,2vw,22px);line-height:1.38;margin:0 0 12px;overflow-wrap:anywhere}
  .conference-record .record-authors{font-size:14px;color:#4f5f70;line-height:1.65;margin:0 0 12px;overflow-wrap:anywhere}
  .record-details{display:flex;flex-wrap:wrap;align-items:center;gap:7px 17px;font-size:12px;color:#6e7c8b}
  .record-badge{display:inline-block;background:#f4e9ec;color:#8f1d35;border:1px solid #ead5da;border-radius:2px;padding:5px 8px;font:800 10px/1.2 Manrope,Arial,sans-serif;letter-spacing:.06em;text-transform:uppercase}
</style>
