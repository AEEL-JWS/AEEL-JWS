---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import {publicationTabs} from '../../lib/navigation';
import {getCollection} from 'astro:content';
const talks=(await getCollection('conferences')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime()||a.data.order-b.data.order);
const years=[...new Set(talks.map(item=>item.data.date.getFullYear()))];
---
<BaseLayout title="Conferences" active="publications"><SectionHero section="Publications / Conferences" title="Sharing discoveries." intro="Talks, posters, and invited presentations from the AEEL team." tabs={publicationTabs}/><section class="section"><div class="shell">{talks.length?years.map(year=><section class="publication-year-group"><h2 class="year-heading">{year}</h2><div class="record-list">{talks.filter(item=>item.data.date.getFullYear()===year).map(item=><article class="record-row"><div><span class="card-kicker">{item.data.presentationType||'Presentation'} · {item.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span><h3>{item.data.title}</h3><p>{item.data.authors}</p><p class="record-meta">{[item.data.conference,item.data.location].filter(Boolean).join(' · ')}</p></div>{item.data.link&&<a class="text-link" href={item.data.link} target="_blank" rel="noopener noreferrer">Details</a>}</article>)}</div></section>):<p class="empty-state">Conference presentations will appear here as they are added.</p>}</div></section></BaseLayout>
