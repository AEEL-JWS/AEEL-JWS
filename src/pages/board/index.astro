---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import DirectoryCards from '../../components/DirectoryCards.astro';
import {boardTabs} from '../../lib/navigation';

const images=[
  '/images/editorial/korea-university-main-building.jpg',
  '/images/editorial/board-hero.png',
  '/images/gallery/hallasan-lab-hiking.jpg',
];
const cards=boardTabs.map(([label,path],i)=>({label,path,image:images[i]}));
---
<BaseLayout title="Board" active="board"><SectionHero section="Board" title="Board" intro="Updates and activities from AEEL."/><DirectoryCards section="Board" cards={cards}/></BaseLayout>
