---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import {boardTabs} from '../../lib/navigation';
import {pageUrl} from '../../lib/links';
---
<BaseLayout title="Board" active="board"><SectionHero section="Board" title="Board" intro="Updates and activities from AEEL." tabs={boardTabs}/><section class="section"><div class="shell link-card-grid">{boardTabs.map(([label,path],i)=><a class="link-card surface-card" href={pageUrl(path)}><span class="card-kicker">0{i+1} / BOARD</span><h2>{label}</h2><span class="text-link">Explore</span></a>)}</div></section></BaseLayout>
