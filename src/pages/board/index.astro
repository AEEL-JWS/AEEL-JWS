---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import {boardTabs} from '../../lib/navigation';
import {pageUrl} from '../../lib/links';
import {getCollection} from 'astro:content';
import NewsCard from '../../components/NewsCard.astro';
const notices=(await getCollection('notices')).filter(item=>item.data.active).sort((a,b)=>Number(b.data.pinned)-Number(a.data.pinned)||b.data.date.getTime()-a.data.date.getTime());
const news=(await getCollection('news')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const gallery=await getCollection('gallery');
---
<BaseLayout title="Board" active="board"><SectionHero section="Board" title="Board" intro="Updates and activities from AEEL." tabs={boardTabs}/>
  <section class="section board-landing"><div class="shell"><div class="section-head editorial-section-head"><div><span class="eyebrow">Notices</span><h2>Announcements.</h2></div><a class="text-link" href={pageUrl('board/notices')}>All notices</a></div><div class="news-list notice-list">{notices.slice(0,5).map(item=><a class="news-item" href={pageUrl('board/notices/'+item.id)}><span class="news-date">{item.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span><div><h3>{item.data.title}</h3><p>{item.data.category||'Notice'}</p></div><span class="news-arrow" aria-hidden="true">↗</span></a>)}</div>
    <div class="section-head editorial-section-head board-news-head"><div><span class="eyebrow">News</span><h2>Stories from AEEL.</h2></div><a class="text-link" href={pageUrl('board/news')}>All news</a></div><div class="news-card-grid editorial-news-grid">{news.slice(0,3).map(item=><NewsCard id={item.id} item={item.data}/>)}</div>
    <div class="gallery-teaser"><div><span class="eyebrow">Gallery</span><h2>Life at AEEL.</h2><p>Research activities, conferences, and moments from the lab.</p></div><a class="text-link" href={pageUrl('board/gallery')}>{gallery.length ? 'Explore gallery' : 'Gallery'}</a></div>
  </div></section></BaseLayout>
