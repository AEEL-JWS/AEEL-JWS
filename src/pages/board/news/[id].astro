---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHero from '../../../components/SectionHero.astro';
import {getCollection,render} from 'astro:content';
import {pageUrl,assetUrl} from '../../../lib/links';
export async function getStaticPaths(){return (await getCollection('news')).map(item=>({params:{id:item.id},props:{item}}))}
const {item}=Astro.props;const {Content}=await render(item);
---
<BaseLayout title={item.data.title} active="board" description={item.data.summary}><SectionHero section={`Board / ${item.data.category} · ${item.data.date.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}`} title={item.data.title} intro={item.data.summary} image={item.data.imageFit==='contain' ? '/images/editorial/wafer-probing.webp' : item.data.image || '/images/editorial/wafer-probing.webp'} /><article class="shell content-article">{item.data.image&&<img class:list={['article-image',{'article-image--contain':item.data.imageFit==='contain'}]} src={assetUrl(item.data.image)} alt={item.data.imageFit==='contain'?`${item.data.title} cover image`:''}/>}<div class="prose"><Content/></div>{item.data.link&&<p><a class="text-link" href={item.data.link} target="_blank" rel="noopener noreferrer">Read original source</a></p>}<a class="text-link article-back" href={pageUrl('board/news')}>Back to news</a></article></BaseLayout>
