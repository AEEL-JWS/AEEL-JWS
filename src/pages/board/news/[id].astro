---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHero from '../../../components/SectionHero.astro';
import {getCollection,render} from 'astro:content';
import {pageUrl,assetUrl} from '../../../lib/links';
export async function getStaticPaths(){
  return (await getCollection('news')).map(item=>({params:{id:item.id},props:{item}}));
}
const {item}=Astro.props;
const {Content}=await render(item);
const hasBody=Boolean(item.body?.trim());
const imageAlreadyInBody=Boolean(item.data.image&&item.body?.includes(item.data.image.split('/').pop()||''));
---
<BaseLayout title={item.data.title} active="board" description={item.data.summary}>
  <SectionHero section={`Board / ${item.data.category} · ${item.data.date.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}`} title={item.data.title} intro={item.data.summary} image={item.data.imageFit==='contain' ? '/images/editorial/wafer-probing.webp' : item.data.image || '/images/editorial/wafer-probing.webp'} />
  <article class="shell content-article news-article">
    {item.data.image&&!imageAlreadyInBody&&<img class:list={['article-image',{'article-image--contain':item.data.imageFit==='contain'}]} src={assetUrl(item.data.image)} alt={item.data.imageFit==='contain'?`${item.data.title} cover image`:''}/>}
    {hasBody&&<div class="prose news-prose"><Content/></div>}
    {!hasBody&&<p class="news-empty">No additional details were provided for this news item.</p>}
    <a class="text-link article-back" href={pageUrl('board/news')}>Back to news</a>
  </article>
</BaseLayout>
