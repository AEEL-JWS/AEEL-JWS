---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {getCollection,render} from 'astro:content';
import {pageUrl,assetUrl} from '../../../lib/links';
export async function getStaticPaths(){
  return (await getCollection('notices')).map(item=>({params:{id:item.id},props:{item}}));
}
const {item}=Astro.props;
const {Content}=await render(item);
const hasBody=Boolean(item.body?.trim());
const hasLegacyBody=Boolean(item.data.body?.trim());
const isEmpty=!hasBody&&!hasLegacyBody&&!item.data.image&&!item.data.attachment;
---
<BaseLayout title={item.data.title} active="board">
  <section class="page-hero">
    <div class="shell page-heading">
      <span class="eyebrow">Board / {item.data.category||'Notice'} · {item.data.date.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</span>
      <h1>{item.data.title}</h1>
    </div>
  </section>
  <article class="shell content-article notice-article">
    {hasBody&&<div class="prose notice-prose"><Content/></div>}
    {!hasBody&&hasLegacyBody&&<div class="prose notice-prose"><p>{item.data.body}</p></div>}
    {item.data.image&&<img class="article-image" src={assetUrl(item.data.image)} alt="" loading="lazy"/>}
    {item.data.attachment&&<p><a class="text-link" href={assetUrl(item.data.attachment)} download>Download attachment</a></p>}
    {isEmpty&&<p class="notice-empty">No additional details were provided for this notice.</p>}
    {item.data.author&&<p class="source-note">Posted by {item.data.author}</p>}
    <a class="text-link article-back" href={pageUrl('board/notices')}>Back to notices</a>
  </article>
</BaseLayout>
