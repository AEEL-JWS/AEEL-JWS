---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {getCollection,render} from 'astro:content';
import {pageUrl,assetUrl} from '../../../lib/links';
export async function getStaticPaths(){return (await getCollection('notices')).map(item=>({params:{id:item.id},props:{item}}))}
const {item}=Astro.props;
const {Content}=await render(item);
---
<BaseLayout title={item.data.title} active="board"><section class="page-hero"><div class="shell page-heading"><span class="eyebrow">Board / Notice · {item.data.date.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</span><h1>{item.data.title}</h1></div></section><article class="shell content-article"><div class="prose"><Content/></div>{item.data.attachment&&<p><a class="text-link" href={assetUrl(item.data.attachment)} download>Download attachment</a></p>}{item.data.author&&<p class="source-note">Posted by {item.data.author}</p>}<a class="text-link article-back" href={pageUrl('board/notices')}>Back to notices</a></article></BaseLayout>
