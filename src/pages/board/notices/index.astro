---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHero from '../../../components/SectionHero.astro';
import {boardTabs} from '../../../lib/navigation';
import {getCollection} from 'astro:content';
import {pageUrl} from '../../../lib/links';
const notices=(await getCollection('notices')).sort((a,b)=>Number(b.data.pinned)-Number(a.data.pinned)||b.data.date.getTime()-a.data.date.getTime());
---
<BaseLayout title="Notices" active="board"><SectionHero section="Board / Notices" title="Announcements." intro="Information and updates for the AEEL community." tabs={boardTabs}/><section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">From the lab</span><h2>Notices</h2></div></div>{notices.length?<div class="news-list">{notices.map(item=><a class="news-item" href={pageUrl('board/notices/'+item.id)}><span class="news-date">{item.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span><div><span class="pill">{item.data.pinned?'Pinned':item.data.category||'Notice'}</span><h3>{item.data.title}</h3></div><span class="news-arrow" aria-hidden="true">↗</span></a>)}</div>:<p class="empty-state">Notices will appear here as they are posted.</p>}</div></section></BaseLayout>
