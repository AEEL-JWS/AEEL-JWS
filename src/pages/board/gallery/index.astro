---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHero from '../../../components/SectionHero.astro';
import {boardTabs} from '../../../lib/navigation';
import {getCollection} from 'astro:content';
import {assetUrl,pageUrl} from '../../../lib/links';
const albums=(await getCollection('gallery')).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime()||a.data.order-b.data.order);
---
<BaseLayout title="Gallery" active="board"><SectionHero section="Board / Gallery" title="Moments in the making." intro="Research, collaboration, and life beyond the lab bench." tabs={boardTabs}/><section class="section"><div class="shell">{albums.length?<div class="gallery-grid">{albums.map(item=><a class="gallery-card" href={pageUrl('board/gallery/'+item.id)}><div class="gallery-cover">{(item.data.cover||item.data.photos[0]?.image)?<img src={assetUrl(item.data.cover||item.data.photos[0]?.image)} alt={item.data.title} loading="lazy"/>:<span aria-hidden="true">AEEL</span>}</div><div class="gallery-card-text"><span>{item.data.category||'Gallery'} · {item.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span><h2>{item.data.title}</h2><small>{item.data.photos.length} photos ↗</small></div></a>)}</div>:<p class="empty-state">Photo albums will appear here as they are added.</p>}</div></section></BaseLayout>
