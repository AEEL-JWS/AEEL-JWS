---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import {memberTabs} from '../../lib/navigation';
import {assetUrl} from '../../lib/links';
import professorData from '../../data/professor.json';
type Professor = Omit<typeof professorData, 'awards' | 'activities'> & {
  orcid?: string;
  researcherProfile?: string;
  universityProfile?: string;
  awards: Array<{title:string;year?:number;order?:number;organization?:string;description?:string}>;
  activities: Array<{role:string;startYear?:number;endYear?:number|null;present?:boolean;order?:number;organization?:string;description?:string}>;
};
const professor: Professor = professorData;
const sorted = <T extends {order?:number}>(items:T[])=>[...items].sort((a,b)=>(a.order??99)-(b.order??99));
const degreeLine=[professor.position,professor.department,professor.institution].filter(Boolean);
---
<BaseLayout title={`Professor ${professor.englishName}`} active="members" description={`Profile of ${professor.englishName}, ${professor.department}, ${professor.institution}.`}>
<SectionHero section="Members / Professor" title="Professor" intro="Research interests, academic background, and professional activities of the principal investigator." tabs={memberTabs} image="/images/editorial/professor-hero.png" imagePosition="center 56%" mobileImagePosition="55% center"/>
<section class="section professor-section"><div class="shell">
  <div class="professor-profile"><div class="professor-portrait">{professor.image&&<img src={assetUrl(professor.image)} alt={`Professor ${professor.englishName}`} />}</div><div class="professor-intro"><span class="eyebrow">Principal investigator</span><h2>{professor.englishName.toUpperCase()}, {professor.degree.toUpperCase()}</h2><p class="professor-affiliation">{degreeLine.map((line)=><span>{line}</span>)}</p><p class="professor-names">{professor.koreanName} · {professor.hanjaName}</p>{professor.biography&&<p class="professor-bio">{professor.biography}</p>}<div class="professor-contact"><div><strong>Email</strong><a href={`mailto:${professor.email}`}>{professor.email}</a></div><div><strong>Phone</strong><a href={`tel:${professor.phone}`}>{professor.phone}</a></div><div><strong>Fax</strong><span>{professor.fax}</span></div><div><strong>Office</strong><span>{professor.office}</span></div></div><div class="profile-links">{[['Google Scholar',professor.googleScholar],['ORCID',professor.orcid],['Researcher profile',professor.researcherProfile],['University profile',professor.universityProfile]].filter(([,url])=>Boolean(url)).map(([label,url])=><a class="text-link" href={url} target="_blank" rel="noopener noreferrer">{label}</a>)}</div></div></div>
  <div class="profile-section"><div class="profile-section-heading"><span>01</span><h2>Education</h2></div><div class="timeline">{sorted(professor.education).map(item=><div class="timeline-row"><span class="timeline-year">{item.year}</span><div><h3>{item.degree} · {item.field}</h3><p>{item.institution}</p><small>{item.location}</small></div></div>)}</div></div>
  <div class="profile-section"><div class="profile-section-heading"><span>02</span><h2>Professional Experience</h2></div><div class="timeline">{sorted(professor.experience).map(item=><div class="timeline-row"><span class="timeline-year">{item.startYear} — {item.present?'Present':item.endYear}</span><div><h3>{item.position}</h3><p>{item.institution}</p><small>{[item.department,item.location].filter(Boolean).join(' · ')}</small></div></div>)}</div></div>
  <div class="profile-section"><div class="profile-section-heading"><span>03</span><h2>Honors & Awards</h2></div><div class="compact-list">{sorted(professor.awards).map(item=><div class="compact-row"><span class="timeline-year">{item.year}</span><div><h3>{item.title}</h3>{item.organization&&<p>{item.organization}</p>}{item.description&&<p>{item.description}</p>}</div></div>)}</div></div>
  <div class="profile-section"><div class="profile-section-heading"><span>04</span><h2>Academic & Professional Activities</h2></div><div class="compact-list activities-list">{sorted(professor.activities).map(item=><div class="compact-row"><span class="timeline-year">{item.startYear}{item.present?' — Present':item.endYear&&item.endYear!==item.startYear?` — ${item.endYear}`:''}</span><div><h3>{item.role}</h3>{item.organization&&<p>{item.organization}</p>}{item.description&&<p>{item.description}</p>}</div></div>)}</div></div>
</div></section></BaseLayout>
