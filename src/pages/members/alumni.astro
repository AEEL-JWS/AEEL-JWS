---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import {memberTabs} from '../../lib/navigation';
import {getCollection} from 'astro:content';
import {assetUrl} from '../../lib/links';
const alumni=(await getCollection('alumni')).filter(item=>item.data.active).sort((a,b)=>a.data.order-b.data.order);
const categories=[
  {value:'Postdoc',label:'Postdoc'},
  {value:'Ph.D. Course',label:'Ph.D.'},
  {value:'M.S. Course',label:'M.S.'},
];
const monthLabel=(month?:string)=>month==='February'?'Feb.':month==='August'?'Aug.':month||'';
---
<BaseLayout title="Alumni" active="members"><SectionHero section="Members / Alumni" title="Alumni" intro="Former members of AEEL and their current affiliations." tabs={memberTabs}/><section class="section"><div class="shell">{alumni.length?categories.map(category=><div class="alumni-group"><h2 class="year-heading">{category.label}</h2><div class="alumni-grid">{alumni.filter(item=>(item.data.category||item.data.degree)===category.value).map(item=><article class="alumni-card surface-card">{item.data.image&&<img src={assetUrl(item.data.image)} alt={item.data.name} loading="lazy"/>}<div><h3>{item.data.name}</h3><p class="alumni-date">{[monthLabel(item.data.graduationMonth),item.data.graduationYear].filter(Boolean).join(' ')}</p><p class="alumni-destination">{[item.data.currentPosition,item.data.currentOrganization||item.data.currentAffiliation].filter(Boolean).join(', ')||item.data.currentText}</p>{item.data.link&&<a class="text-link" href={item.data.link} target="_blank" rel="noopener noreferrer">Profile</a>}</div></article>)}</div></div>):<p class="empty-state">Alumni profiles will appear here as they are added.</p>}</div></section></BaseLayout>

<style>
  .alumni-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; }
  .alumni-card { min-width: 0; padding: 20px; }
  .alumni-card > div { min-width: 0; }
  .alumni-destination { overflow-wrap: anywhere; }
  @media (max-width: 1100px) {
    .alumni-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .alumni-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
