---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import {memberTabs} from '../../lib/navigation';
import {getCollection} from 'astro:content';
import {assetUrl} from '../../lib/links';
const alumni=(await getCollection('alumni')).sort((a,b)=>(b.data.graduationYear??0)-(a.data.graduationYear??0)||a.data.order-b.data.order);
const years=[...new Set(alumni.map(item=>item.data.graduationYear||'Earlier'))];
---
<BaseLayout title="Alumni" active="members"><SectionHero section="Members / Alumni" title="Where inquiry leads." intro="AEEL alumni and the paths they have taken beyond the lab." tabs={memberTabs}/><section class="section"><div class="shell">{alumni.length?years.map(year=><div class="alumni-year"><h2 class="year-heading">{year}</h2><div class="alumni-grid">{alumni.filter(item=>(item.data.graduationYear||'Earlier')===year).map(item=><article class="alumni-card surface-card">{item.data.image&&<img src={assetUrl(item.data.image)} alt={item.data.name} loading="lazy"/>}<div><span class="card-kicker">{item.data.degree||item.data.previousPosition}</span><h3>{item.data.name}</h3><p>{[item.data.currentPosition,item.data.currentAffiliation].filter(Boolean).join(' · ')}</p>{item.data.link&&<a class="text-link" href={item.data.link} target="_blank" rel="noopener noreferrer">Profile</a>}</div></article>)}</div></div>):<p class="empty-state">Alumni profiles will appear here as they are added.</p>}</div></section></BaseLayout>
