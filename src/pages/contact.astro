---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import contact from '../data/contact.json';
---
<BaseLayout title="Contact" active="contact"><SectionHero section="Contact" title="Contact" intro="Contact information and location of the AEEL Lab at Korea University."/><section class="section"><div class="shell contact-page-grid"><div><span class="eyebrow">Contact information</span><h2 class="join-title">Contact details</h2><p class="intro-copy">Reach our lab for research inquiries, collaborations, and opportunities.</p><dl class="contact-details"><div><dt>Lab contact</dt><dd>{contact.professor}</dd></div><div><dt>Email</dt><dd><a href={'mailto:'+contact.email}>{contact.email} ↗</a></dd></div><div><dt>Phone</dt><dd><a href={'tel:'+contact.phone}>{contact.phone}</a></dd></div><div><dt>Fax</dt><dd>{contact.fax}</dd></div><div><dt>Office</dt><dd>{contact.building}, Room {contact.room}</dd></div></dl></div><aside class="location-panel"><span class="eyebrow">Location</span><h2>{contact.institution}</h2><p>{contact.building} · Room {contact.room}</p><address>{contact.address}</address><a class="text-link" href={'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(contact.address)} target="_blank" rel="noopener noreferrer">View on map</a></aside></div></section><section class="section join-section"><div class="shell"><div class="section-head"><div><span class="eyebrow">Join us</span><h2>Research opportunities</h2><p>{contact.recruitmentIntro}</p></div></div><div class="opportunity-grid">{contact.opportunities.map(item=><article class="opportunity-card"><h3>{item.title}</h3><p>{item.description}</p></article>)}</div><p class="recruitment-instructions">{contact.recruitmentInstructions}</p><a class="button" href={'mailto:'+contact.email}>Email the lab <span aria-hidden="true">↗</span></a></div></section></BaseLayout>
