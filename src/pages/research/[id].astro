---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { pageUrl, assetUrl } from '../../lib/links';
export async function getStaticPaths() {
  return (await getCollection('research')).map(item => ({ params: { id: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
---
<BaseLayout title={item.data.title} active="research" description={item.data.summary}>
  <section class="page-hero"><div class="shell page-heading"><span class="eyebrow">{item.data.eyebrow || 'Research'}</span><h1>{item.data.title}</h1><p>{item.data.summary}</p></div></section>
  <article class="shell content-article">
    {item.data.image && <img class="article-image" src={assetUrl(item.data.image)} alt="" />}
    <div class="prose"><Content /></div>
    <a class="text-link article-back" href={pageUrl('research')}>Back to research</a>
  </article>
</BaseLayout>
