---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pageUrl, assetUrl } from '../../lib/links';
const research = (await getCollection('research')).sort((a,b) => a.data.order - b.data.order);
---
<BaseLayout title="Research" active="research" description="Explore AEEL research in emerging electronic devices and energy conversion.">
  <section class="page-hero"><div class="shell page-heading"><span class="eyebrow">Research</span><h1>Ideas into devices.</h1><p>Our work spans materials, device physics, and integrated systems for the next generation of electronics.</p></div></section>
  <section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">Focus areas</span><h2>Where we work</h2><p>Research themes evolve as our team explores new questions and applications.</p></div></div><div class="card-grid">
    {research.map((item,i) => <a class="research-card surface-card" href={pageUrl(`research/${item.id}`)}><div class={`research-visual default-${i%5+1}`}>{item.data.image && <img src={assetUrl(item.data.image)} alt="" loading="lazy" />}</div><div class="research-card-body"><span class="card-kicker">{item.data.eyebrow || `AREA 0${i+1}`}</span><h3>{item.data.title}</h3><p>{item.data.summary}</p><span class="text-link">Explore area</span></div></a>)}
  </div></div></section>
</BaseLayout>
