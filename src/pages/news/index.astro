---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { pageUrl } from '../../lib/links';
const news = (await getCollection('news')).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="News" active="news" description="Updates and stories from the AEEL lab.">
  <section class="page-hero"><div class="shell page-heading"><span class="eyebrow">News</span><h1>Inside the lab.</h1><p>Discover recent papers, milestones, and stories from our research group.</p></div></section>
  <section class="section"><div class="shell"><div class="section-head"><div><span class="eyebrow">Latest updates</span><h2>Lab news</h2></div></div><div class="news-list">{news.map(item => <a class="news-item" href={pageUrl(`news/${item.id}`)}><span class="news-date">{item.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</span><div><span class="pill">{item.data.category}</span><h3>{item.data.title}</h3><p>{item.data.summary}</p></div><span class="news-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
</BaseLayout>
