import {getCollection} from 'astro:content';
import {pageUrl} from '../../lib/links';
export async function getStaticPaths(){return (await getCollection('news')).map(item=>({params:{id:item.id},props:{item}}))}
const {item}=Astro.props;
return Astro.redirect(pageUrl('board/news/'+item.id),301);
