---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import {publicationTabs} from '../lib/navigation';
import {pageUrl} from '../lib/links';
import {getCollection} from 'astro:content';
import PublicationItem from '../components/PublicationItem.astro';
const papers=(await getCollection('publications')).sort((a,b)=>b.data.year-a.data.year||a.data.order-b.data.order);
---
<BaseLayout title="Publications" active="publications"><SectionHero section="Publications" title="Publications" intro="Research outputs from the AEEL group." tabs={publicationTabs}/><section class="section archive-landing"><div class="shell"><div class="section-head editorial-section-head"><div><span class="eyebrow">Research archive</span><h2>Recent papers</h2><p>Peer-reviewed research from AEEL.</p></div><a class="text-link" href={pageUrl('publications/papers')}>All papers</a></div><div class="publication-list">{papers.slice(0,5).map(item=><PublicationItem item={item.data}/>)}</div><div class="archive-paths">{publicationTabs.slice(1).map(([label,path])=><a href={pageUrl(path)}><span class="card-kicker">Research outputs</span><strong>{label}</strong><span aria-hidden="true">↗</span></a>)}</div></div></section></BaseLayout>
