---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHero from '../components/SectionHero.astro';
import DirectoryCards from '../components/DirectoryCards.astro';
import {publicationTabs} from '../lib/navigation';
const images=[
  '/images/editorial/publications-hero.png',
  '/images/editorial/patents-card.png',
  '/images/editorial/conferences-card.png',
];
const cards=publicationTabs.map(([label,path],i)=>({label,path,image:images[i]}));
---
<BaseLayout title="Publications" active="publications"><SectionHero section="Publications" title="Publications" intro="Research outputs from the AEEL group."/><DirectoryCards section="Publications" cards={cards}/></BaseLayout>
